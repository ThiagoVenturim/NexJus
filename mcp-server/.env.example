# Copie para .env (fora do Git) e ajuste. Nunca commite o .env.
NEXJUS_MCP_DATA_FILE=./nexjus-data.json
NEXJUS_MCP_PRIVACY=minimo
NEXJUS_MCP_READ_ONLY=false

# Chave publica da API do DataJud, publicada pelo CNJ. Deixe vazio para desligar o DataJud.
NEXJUS_DATAJUD_API_KEY=
NEXJUS_DATAJUD_TIMEOUT=15

# Backend opcional (app/) para generate_agenda com fonte=backend.
NEXJUS_BACKEND_URL=
NEXJUS_API_TOKEN=

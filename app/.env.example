# Copie para .env e ajuste. O arquivo .env nunca vai para o repositorio.

# Banco de dados. Padrao: SQLite local. Para Postgres use, por exemplo,
# postgresql+psycopg://USUARIO:SENHA@127.0.0.1:5432/nexjus
NEXJUS_DATABASE_URL=sqlite:///./nexjus.db

# Token que a extensao envia no cabecalho Authorization: Bearer <token>.
# Gere um valor aleatorio com: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXJUS_API_TOKEN=

# Origens liberadas para CORS, separadas por virgula (ex.: chrome-extension://<id-da-extensao>).
NEXJUS_CORS_ORIGINS=

# Alertas por e-mail (opcional). Sem NEXJUS_SMTP_HOST nenhum e-mail e enviado.
NEXJUS_SMTP_HOST=
NEXJUS_SMTP_PORT=587
NEXJUS_SMTP_USER=
NEXJUS_SMTP_PASSWORD=
NEXJUS_SMTP_STARTTLS=true
NEXJUS_ALERT_FROM=
NEXJUS_ALERT_TO=

# Agenda diaria: horario do envio (HH:MM) e janela de dias a frente.
NEXJUS_AGENDA_HORA=07:30
NEXJUS_AGENDA_DIAS=7

# Usado somente pelo docker-compose.yml (Postgres opcional).
POSTGRES_USER=nexjus
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=nexjus
POSTGRES_PORT=5432
FASTAPI_PORT=8000
